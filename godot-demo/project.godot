; Vizemes dev project — shared OnnxLoader addon (symlink) + ci-smoke fixture.
config_version=5

[application]
config/name="VizemesOnnxLoaderDev"
run/main_scene="res://viseme_timeline.tscn"
config/features=PackedStringArray("4.6")

[native_extensions]
paths=["res://addons/onnx_loader/onnx_loader.gdextension", "res://addons/vizemes_mel/vizemes_mel.gdextension"]

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="disabled"
